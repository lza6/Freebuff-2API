{
  "manifest_version": 3,
  "name": "Freebuff2API 一键登录",
  "version": "1.1.0",
  "description": "读取 freebuff.com 的登录凭证（含 HttpOnly Cookie）并一键发送到本地 Freebuff2API 网关；面板点「一键登录」全自动，未登录时自动打开登录页等待。",
  "permissions": ["cookies", "notifications", "storage"],
  "host_permissions": ["https://freebuff.com/*", "https://*.freebuff.com/*", "http://127.0.0.1/*", "http://localhost/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1/*", "http://localhost/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ],
  "externally_connectable": {
    "matches": ["http://127.0.0.1/*", "http://localhost/*"]
  },
  "action": {
    "default_title": "把 Freebuff 登录凭证导入本地网关",
    "default_icon": {
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "128": "icons/icon128.png"
  }
}
